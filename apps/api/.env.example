# ==============================================================================
# BullSutra Backend Environment Configuration
# ==============================================================================
# Copy this file to .env (e.g., `cp .env.example .env`) and update the values below.
# DO NOT commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Mode
# ------------------------------------------------------------------------------
# Choices: "local", "test", "prod"
ENV=local
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Confidential: Set your own database username and a strong password.
# Ensure the PostgreSQL database exists and has the 'citext' extension enabled:
#   CREATE EXTENSION IF NOT EXISTS citext;
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=bullsutra

# Connection URLs:
# Async URL used by the FastAPI backend runtime:
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password_here@localhost:5432/bullsutra
# Sync URL used by Alembic for database migrations:
DATABASE_URL_SYNC=postgresql+psycopg://postgres:your_secure_postgres_password_here@localhost:5432/bullsutra

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Confidential: Generate a cryptographically secure 64-character hex secret.
# In Linux/macOS/Git Bash: openssl rand -hex 32
# In PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# In production, this MUST NOT use default placeholders and must be >= 32 characters.
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Confidential: Pepper used for hashing API keys.
# Generate a random hex string (e.g., openssl rand -hex 16)
API_KEY_PEPPER=replace_with_a_random_32_char_hex_pepper_string_here

# Allowed CORS origins (comma-separated):
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Large Language Models (LLM) & Multi-Agent Narrator
# ------------------------------------------------------------------------------
# Primary LLM provider: "gemini", "ollama", "omniroute", or "fake" (for offline tests)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Fallback LLM provider if primary fails or is rate-limited:
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL=qwen2.5:3b-instruct

# Confidential: Google AI Studio API Key (Required if LLM_PROVIDER is "gemini")
# Obtain from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Local Ollama endpoint (Required if using Ollama):
OLLAMA_BASE_URL=http://localhost:11434

# Optional: OpenAI-compatible OmniRoute proxy settings
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# LLM execution limits & timeouts
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 5. Embeddings & NLP Models
# ------------------------------------------------------------------------------
SENTIMENT_MODEL=ProsusAI/finbert
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_HOME=data/models

# ------------------------------------------------------------------------------
# 6. Vector Database (ChromaDB)
# ------------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ------------------------------------------------------------------------------
# 7. Scraper & External Sources
# ------------------------------------------------------------------------------
PRICE_SOURCE=nepse_api
SCRAPER_USER_AGENT=BullSutraBot/1.0 (academic project; contact: info@bullsutra.local)
SCRAPER_CONTACT_EMAIL=info@bullsutra.local
SCRAPER_DELAY_SECONDS=2.5

# ------------------------------------------------------------------------------
# 8. Background Workers & Job Scheduler
# ------------------------------------------------------------------------------
ENABLE_SCHEDULER=true
WORKER_CONCURRENCY=2
RATE_LIMIT_DEFAULT=120/minute

# ------------------------------------------------------------------------------
# 9. Data Storage & Pipelines
# ------------------------------------------------------------------------------
# Relative or absolute path to the financial datasets directory (DuckDB / Parquet files)
DATASETS_DIR=./data/datasets

# ------------------------------------------------------------------------------
# 10. Monitoring, Logging & Alerts (Optional)
# ------------------------------------------------------------------------------
# Confidential: Sentry DSN for error monitoring (leave empty to disable)
SENTRY_DSN=

# Optional: Incoming webhook URL for administrative alert notifications
ADMIN_NOTIFY_WEBHOOK=
