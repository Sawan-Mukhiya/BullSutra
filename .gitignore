# ==============================================================================
# BullSutra Git Ignore Rules
# ==============================================================================

# Internal documentation & development audit notes
/docs

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
apps/api/build/
dist/
.eggs/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
.vercel
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TypeScript build cache
*.tsbuildinfo
next-env.d.ts

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/

# ------------------------------------------------------------------------------
# Data, Models, & Local Databases
# ------------------------------------------------------------------------------
data/
data/raw/
data/staging/
data/core/
data/marts/
data/models/
*.parquet
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
.memory/*.lock
.memory/*.db-shm
.memory/*.db-wal

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.vscode/
.idea/
